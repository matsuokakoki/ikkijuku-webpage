---
import type { Content } from '../lib/schema';
import { monthCells } from '../lib/format';
interface Props {
  month: Content['calendar'][number];
  previous?: string;
  next?: string;
}
const { month, previous, next } = Astro.props;
const cells = monthCells(month.month, month.days);
---

<section
  class="calendar-month"
  data-live-calendar
  data-month={month.month}
  data-fetched-at={month.fetchedAt}
>
  <div class="calendar-controls">
    {previous ? <a href={`/calendar/${previous}/`}>← 前月</a> : <span></span>}
    <h2>{month.month.replace('-', '年')}月</h2>
    {next ? <a href={`/calendar/${next}/`}>翌月 →</a> : <span></span>}
  </div>
  <table class="calendar">
    <caption class="sr-only">{month.month}の休講日カレンダー</caption>
    <thead>
      <tr>
        {['日', '月', '火', '水', '木', '金', '土'].map((d) => (
          <th scope="col">{d}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {Array.from({ length: cells.length / 7 }, (_, week) => (
        <tr>
          {cells.slice(week * 7, week * 7 + 7).map((cell) => (
            <td
              data-date={cell?.date}
              class:list={[{ closed: cell?.closed, sunday: cell?.sunday }]}
            >
              {cell && (
                <>
                  <span>{cell.day}</span>
                  <small data-closure-label>
                    {cell.closed ? month.reasons[cell.date] || '休講' : cell.sunday ? '定休日' : ''}
                  </small>
                </>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
  <p class="preserve-lines fine-print">{month.note}</p>
  <p class="fine-print" role="status" aria-live="polite" data-calendar-status>
    休講日は出席管理システムの公開情報を表示しています。
  </p>
</section>
<script>
  import '../scripts/calendar-client';
</script>
