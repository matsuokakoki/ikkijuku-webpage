---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { getContent } from '../../lib/content';
export async function getStaticPaths() {
  const { achievements } = await getContent();
  return achievements.map((item) => ({
    params: { year: String(item.year) },
    props: { item, years: achievements.map((x) => x.year) },
  }));
}
const { item, years } = Astro.props;
---

<Layout title={`${item.year}年度 合格実績`}>
  <PageHeading en="ACHIEVEMENTS" title={`${item.year}年度 合格実績`} />
  <div class="wrap content-section">
    <nav class="year-links compact" aria-label="年度切り替え">
      {years.map((y) => (
        <a href={`/achievements/${y}/`} aria-current={y === item.year ? 'page' : undefined}>
          {y}年度
        </a>
      ))}
    </nav>
    <dl class="student-counts">
      <div>
        <dt>高校生</dt>
        <dd>{item.high}名</dd>
      </div>
      <div>
        <dt>浪人生</dt>
        <dd>{item.ronin}名</dd>
      </div>
      <div>
        <dt>中学生</dt>
        <dd>{item.junior}名</dd>
      </div>
    </dl>
    {item.groups.map((group) => (
      <section class="results-group">
        <h2>{group.label}</h2>
        {group.items.length ? (
          <ul class="school-grid">
            {group.items.map((row) => (
              <li>
                <h3>{row.school}</h3>
                {row.department && <p>{row.department}</p>}
                {row.count !== null && <p>{row.count}名</p>}
                {row.note && <p class="fine-print">{row.note}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p>掲載する実績はありません。</p>
        )}
      </section>
    ))}
    <a class="text-link" href="/achievements/">
      ← 合格実績一覧に戻る
    </a>
  </div>
</Layout>
