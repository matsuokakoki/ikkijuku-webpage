---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Calendar from '../../components/Calendar.astro';
import { getContent } from '../../lib/content';
import { calendarNavigation } from '../../lib/calendar';
const { calendar } = await getContent();
const { months, selected, index } = calendarNavigation(calendar);
---

<Layout title="休講日">
  <PageHeading
    en="CALENDAR"
    title="休講日のお知らせ"
    lead="公開されている月の休講日をご案内します。"
  />
  <section class="wrap content-section calendar-content">
    {selected ? (
      <Calendar
        month={selected}
        previous={months[index - 1]?.month}
        next={months[index + 1]?.month}
      />
    ) : (
      <div class="empty-state">
        <p>現在、掲載されている月の予定はありません。最新の予定は教室にお問い合わせください。</p>
        <a class="text-link" href="/contact/">
          お問い合わせ ↗
        </a>
      </div>
    )}
    <h2>公開中の月</h2>
    <nav class="year-links compact" aria-label="休講日の対象月">
      {months.toReversed().map((m) => (
        <a href={`/calendar/${m.month}/`}>{m.month}</a>
      ))}
    </nav>
    <p class="fine-print">
      通常の授業時間は<a href="/courses/">授業・料金</a>をご覧ください。
    </p>
  </section>
</Layout>
